# AI-Augmented CI/CD Pipeline Environment Template
# Copy to .env for local configuration (never commit real credentials)

# Control & Authentication Backend
PORT=4001
NODE_ENV=development
DB_PATH=./data/pipeline.db

# Advisory Gemini AI Code Review (Optional)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Actions Secrets (for remote repository CI/CD)
# - GEMINI_API_KEY: Advisory PR code review
# - FAILURE_WEBHOOK_URL: Webhook URL for failure-only alerting
FAILURE_WEBHOOK_URL=https://webhook.site/placeholder-alert-endpoint
