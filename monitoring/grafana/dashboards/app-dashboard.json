{
  "title": "Pipeline Dashboard — App Metrics",
  "uid": "pipeline-dashboard-app",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Requests per second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(nginx_http_requests_total{job=\"pipeline-dashboard\"}[5m]))",
          "legendFormat": "req/s"
        }
      ]
    },
    {
      "id": 2,
      "title": "Active connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "nginx_connections_active{job=\"pipeline-dashboard\"}",
          "legendFormat": "active"
        }
      ]
    },
    {
      "id": 3,
      "title": "Exporter up",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "nginx_up{job=\"pipeline-dashboard\"}",
          "legendFormat": "up"
        }
      ]
    },
    {
      "id": 4,
      "title": "Pod count (dev + prod)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "targets": [
        {
          "expr": "sum(kube_deployment_status_replicas{deployment=\"pipeline-dashboard\"})",
          "legendFormat": "replicas"
        }
      ]
    }
  ]
}
